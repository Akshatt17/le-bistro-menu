# MIME types for 3D model files - Safari requires specific MIME types
AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType model/vnd.usdz+zip .usdz

# Additional Safari-specific MIME types
AddType application/octet-stream .usdz
AddType model/gltf-binary .glb

# Enable CORS for 3D model files
<FilesMatch "\.(glb|gltf|usdz)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
</FilesMatch>

# Cache control for 3D models
<FilesMatch "\.(glb|gltf|usdz)$">
    ExpiresActive On
    ExpiresByType model/gltf-binary "access plus 1 month"
    ExpiresByType model/gltf+json "access plus 1 month"
    ExpiresByType model/vnd.usdz+zip "access plus 1 month"
</FilesMatch>
